{
  "folders": [
    {
      "path": ".",
      "name": "chromium-root"
    }
  ],
  "settings": {
    // 禁用 Git 子模块检测
    "git.detectSubmodules": false,
    "git.detectSubmodulesLimit": 0,
    // 隐藏你不需要看到的目录（减少文件列表干扰）
    "files.exclude": {
      "build": true,
    },
    // 搜索时排除不需要的目录（不影响文件列表显示）
    "search.exclude": {
      "**/out": true,
      "**/build": true,
      "**/buildtools": true,
      "**/tools": true,
      "**/third_party": true, // 排除整个 third_party，这样搜索结果不包含它
      "**/.git": true,
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/*.pyc": true
    },
    // 文件监视排除（避免 watcher 负载）
    "files.watcherExclude": {
      "**/out": true,
      "**/build": true,
      "**/third_party": true,
      "**/.git": true
    },
    // 禁用 VSCode 自带 C++ IntelliSense
    "C_Cpp.intelliSenseEngine": "disabled",
    // 配置 clangd
    "clangd.path": "${workspaceFolder}/build/src/third_party/llvm-build/Release+Asserts/bin/clangd.exe",
    "clangd.arguments": [
      "--compile-commands-dir=${workspaceFolder}/build/out/Default",
      "--query-driver=${workspaceFolder}/build/src/third_party/llvm-build/Release+Asserts/bin/clang-cl.exe",
      "--background-index",
      "--clang-tidy",
      "-j=4",
      "--header-insertion=never"
    ],
    // 显式指定 C/C++ 默认格式化工具为 clangd，避免多个 formatter 冲突弹窗
    "[c]": {
      "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[cpp]": {
      "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },

    // ===== Python/Pylance 优化 =====
    "python.languageServer": "Pylance",
    // Python 分析排除（避免分析不需要的目录）
    "python.analysis.exclude": [
      "**/out",
      "**/build",
    ],
    "python.analysis.ignore": [
      "**/out/**",
      "**/build/**",
    ],
  },
  "extensions": {
    "recommendations": [
      "llvm-vs-code-extensions.vscode-clangd"
    ]
  },
}